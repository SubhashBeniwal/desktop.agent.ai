# Copy to /etc/aio-relay.env on the server, fill in real secrets, then:
#   sudo chown root:root /etc/aio-relay.env && sudo chmod 600 /etc/aio-relay.env
#
# Generate strong tokens with:  openssl rand -hex 32

# Token daemons must present (Authorization: Bearer <this>) on /agent.
AIO_AGENT_TOKEN=replace-with-a-long-random-string

# Token control apps (Flutter) must present on /control.
AIO_CONTROL_TOKEN=replace-with-a-different-long-random-string
